# Copy this file to ".env" and paste your own keys. Never share .env.

# Free key from https://aistudio.google.com  (Get API key)
GEMINI_API_KEY=paste_your_gemini_key_here

# Free token from https://huggingface.co/settings/tokens  (Read access is enough)
HF_TOKEN=paste_your_huggingface_token_here

# Which vision backend to use: hf (Hugging Face API), ollama (local) or label (no vision)
VLM_BACKEND=hf

# Optional - change models if needed
GEMINI_MODEL=gemini-2.5-flash
QWEN_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
OLLAMA_MODEL=qwen2.5vl:3b
HF_DATASET=kannanwisen/Indian-Traffic-Sign-Classification
